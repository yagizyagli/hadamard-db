{
  "compilerOptions": {
    "target": "ES2022",                          /* Enforce modern ECMAScript execution performance */
    "module": "commonjs",                        /* Required for seamless Neon-CLI binary addon hookups */
    "lib": ["ES2022"],                           /* Inject high-performance built-in JS type definitions */
    "declaration": true,                         /* Automatically generate corresponding '.d.ts' type definitions */
    "sourceMap": false,                          /* Disable source maps to reduce production deployment foot-print */
    "outDir": "./dist",                          /* Redirect compiled JS production assets into the distribution layer */
    "isolatedModules": true,                     /* Ensure safe compilation boundaries across multiple modules */
    "strict": true,                              /* Enable all strict type-checking options for enterprise safety */
    "noImplicitAny": true,                       /* Raise error on expressions and declarations with an implied 'any' type */
    "strictNullChecks": true,                    /* Ensure null and undefined conditions are explicitly neutralized */
    "strictFunctionTypes": true,                 /* Enforce rigorous checking of function types and definitions */
    "noImplicitThis": true,                      /* Raise error on 'this' expressions with an implied 'any' type */
    "alwaysStrict": true,                        /* Parse in strict mode and emit "use strict" for each source file */
    "noUnusedLocals": true,                      /* Report errors on unused local variables to keep the engine lean */
    "noUnusedParameters": true,                  /* Report errors on unused parameters within algorithmic loops */
    "noImplicitReturns": true,                   /* Ensure all code paths in functions return an explicit value */
    "noFallthroughCasesInSwitch": true,          /* Report errors for fallthrough cases in switch statements */
    "moduleResolution": "node",                  /* Determine how modules get resolved under Node.js runtime layers */
    "esModuleInterop": true,                     /* Emit additional JavaScript to ease support for importing CommonJS modules */
    "experimentalDecorators": true,              /* Enables experimental support for ES7 decorators for NestJS frameworks */
    "emitDecoratorMetadata": true,               /* Enables metadata generation for dependency injection containers */
    "skipLibCheck": true,                        /* Skip type checking of declaration files to accelerate build speeds */
    "forceConsistentCasingInFileNames": true     /* Disallow inconsistently-cased references to the same file */
  },
  "include": ["src/**/*", "index.ts"],
  "exclude": ["node_modules", "dist"]
}
